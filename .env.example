MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=blog_db
MYSQL_USER=campus_user
MYSQL_PASSWORD=
DATABASE_URL=mysql+pymysql://campus_user:你的URL编码密码@mysql:3306/blog_db?charset=utf8mb4
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ---- 邮箱验证码登录/注册（支持用户任意邮箱收信；发信走下方 SMTP）----
# 真实授权码只写服务器/本地 .env，不要提交仓库
#
# 主通道 QQ：
#   SMTP_HOST=smtp.qq.com SMTP_PORT=465 SMTP_USE_SSL=1 SMTP_USE_TLS=0
#   SMTP_USER=你的QQ@qq.com SMTP_PASSWORD=授权码
# 备用 Gmail：smtp.gmail.com 587 + 应用专用密码（去掉空格）
# 备用 Outlook：smtp.office365.com 587
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=0
SMTP_USE_SSL=1
EMAIL_DEV_MODE=0
EMAIL_REQUIRE_CODE_ON_REGISTER=1
EMAIL_CODE_TTL_MINUTES=10
EMAIL_SEND_COOLDOWN_SECONDS=60
