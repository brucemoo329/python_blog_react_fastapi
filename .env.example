MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=blog_db
MYSQL_USER=campus_user
MYSQL_PASSWORD=
DATABASE_URL=mysql+pymysql://campus_user:你的URL编码密码@mysql:3306/blog_db?charset=utf8mb4
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ---- 邮箱验证码登录/注册（支持 QQ / Gmail / Outlook 等任意邮箱）----
# 不配置 SMTP 时默认开发模式：接口会返回 dev_code，不真实发信
# QQ 邮箱示例：SMTP_HOST=smtp.qq.com  SMTP_PORT=465  SMTP_USE_SSL=1
#   SMTP_USER=你的QQ@qq.com  SMTP_PASSWORD=QQ邮箱授权码（非登录密码）
# Gmail：smtp.gmail.com 587 + 应用专用密码
# Outlook：smtp.office365.com 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
SMTP_USE_SSL=0
EMAIL_DEV_MODE=
EMAIL_REQUIRE_CODE_ON_REGISTER=1
EMAIL_CODE_TTL_MINUTES=10
EMAIL_SEND_COOLDOWN_SECONDS=60
